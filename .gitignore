# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database
*.db
*.db-journal
*.sqlite
prisma/*.db

# temporary logs and test renders
*-out.txt
admin_rendered.html
sitemap_urls.txt
client_secret*.json

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch files
scratch/

# Rust build artifacts
tools/**/target/
src-tauri/target/

# Windows desktop shortcuts
*.lnk

