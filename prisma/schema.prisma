datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  passwordHash       String?
  name               String
  phone              String?
  avatar             String?
  role               String                  @default("USER") // USER | ADMIN
  plan               String                  @default("FREE") // FREE | ANNUAL_50K | LIFETIME_VIP_200K
  planExpiresAt      DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  sessions           Session[]
  sites              Site[]
  orders             Order[]
  purchasedTemplates UserPurchasedTemplate[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Template {
  id           String                  @id // 'burgundy' | 'pastel' | 'floral' | 'retro'
  name         String
  slug         String                  @unique
  description  String
  tier         String                  @default("BASIC") // BASIC | VIP
  price        Int                     @default(0) // Giá bán lẻ (30.000 VNĐ cho mẫu VIP)
  badge        String?
  thumbnail    String
  isActive     Boolean                 @default(true)
  displayOrder Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  sites        Site[]
  purchases    UserPurchasedTemplate[]
}

model UserPurchasedTemplate {
  id          String   @id @default(cuid())
  userId      String
  templateId  String
  pricePaid   Int
  purchasedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    Template @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
}

model Site {
  id                String         @id @default(cuid())
  slug              String         @unique
  ownerId           String
  templateId        String
  title             String
  status            String         @default("DRAFT") // DRAFT | ACTIVE | EXPIRED_BACKUP | ARCHIVED
  viewCount         Int            @default(0)
  maxViews          Int            @default(300) // 300 cho Free, -1 là Không giới hạn
  activeExpiresAt   DateTime?      // Hạn xem công khai (+30 ngày cho Free, +365 ngày cho 50k)
  backupExpiresAt   DateTime?      // Hạn backup trong DB (+30 ngày sau activeExpiresAt)
  draftData         String         // JSON text
  publishedSnapshot String?        // JSON text
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template          Template       @relation(fields: [templateId], references: [id])
  rsvps             RsvpResponse[]
  wishes            WishMessage[]
}

model RsvpResponse {
  id          String   @id @default(cuid())
  siteId      String
  guestName   String
  phone       String?
  attending   Boolean
  partySize   Int      @default(1)
  eventTarget String?
  createdAt   DateTime @default(now())

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model WishMessage {
  id        String   @id @default(cuid())
  siteId    String
  author    String
  content   String
  createdAt DateTime @default(now())

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  code          String        @unique // LS50_xxx, LS200_xxx, LSTP_xxx
  type          String        // PLAN_ANNUAL_50K | PLAN_LIFETIME_VIP_200K | SINGLE_TEMPLATE_VIP
  targetItemId  String?
  amount        Int
  status        String        @default("PENDING") // PENDING | PAID | EXPIRED | CANCELLED
  paymentMethod String        @default("VIETQR_SEPAY")
  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id              String   @id @default(cuid())
  orderId         String?
  provider        String   @default("sepay")
  providerTxnId   String   @unique
  bankAccount     String?
  amount          Int
  transferContent String?
  rawPayload      String?
  receivedAt      DateTime @default(now())

  order           Order?   @relation(fields: [orderId], references: [id])
}

model CustomFont {
  id         String   @id @default(cuid())
  name       String
  family     String
  googleFont String?
  fileUrl    String?
  desc       String?
  category   String   @default("script") // script | serif | sans
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CustomGraphic {
  id            String   @id @default(cuid())
  name          String
  src           String
  category      String   @default("Yếu tố đám cưới")
  subCategory   String?
  defaultWidth  Int      @default(100)
  defaultHeight Int      @default(100)
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
