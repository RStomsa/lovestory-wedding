{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LoveStory Studio",
  "version": "2.0.0",
  "identifier": "com.lovestory.studio",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000/admin/studio",
    "beforeBuildCommand": "",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoveStory Studio - Quản Trị & Thiết Kế Thiệp Cưới Đa Nền Tảng",
        "url": "http://localhost:3000/admin/studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
