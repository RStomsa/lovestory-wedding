      "zIndex": 78,
      "opacity": 1.0,
      "text": "Nơi Lễ Kỷ Niệm được tổ chức",
      "fontFamily": "Cormorant Garamond",
      "fontSize": 18,
      "color": "#707070",
      "textAlign": "center",
