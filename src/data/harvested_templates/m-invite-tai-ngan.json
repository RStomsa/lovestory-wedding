    },
    {
      "id": "elem-element_text_9uv4j39qs15",
      "type": "text",
      "x": 290.8,
      "y": 3079.4,
      "width": 273.2,
      "height": 166.0,
      "rotation": 0.0,
      "zIndex": 79,
      "opacity": 1.0,
      "text": "Ngan là cô gái dịu dàng, chân thành và luôn mang đến sự ấm áp cho những người xung quanh. Với nụ cười tươi sáng và trái tim giàu yêu thương, Ngan đã trở thành người bạn đồng hành tuyệt vời, cùng xây dựng một hành trình hạnh phúc và ý nghĩa.",
      "fontFamily": "Lora",
      "fontSize": 16,
      "color": "#707070",
      "textAlign": "center",
      "letterSpacing": 0.0,
      "lineHeight": 1.4
    },
    {
      "id": "elem-element_text_qu7zgvzrkrh",
      "type": "text",
      "x": 4.9,
      "y": 3524.3,
      "width": 272.6,
      "height": 146.0,
      "rotation": 0.0,
      "zIndex": 80,
      "opacity": 1.0,
      "text": "Tai là người điềm đạm, trách nhiệm và luôn tràn đầy nhiệt huyết trong cuộc sống. Với sự chân thành, bao dung và tình yêu sâu sắc dành cho gia đình, Tai là điểm tựa vững chắc để cùng Ngan viết tiếp câu chuyện tình yêu của riêng mình.",
      "fontFamily": "Lora",
      "fontSize": 16,
      "color": "#707070",
      "textAlign": "center",
      "letterSpacing": 0.0,
      "lineHeight": 1.4
    },
