---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LoveStory - Nền Tảng Thiệp Cưới Siêu Tốc">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md w-full bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-xl border border-stone-200 space-y-5">
      <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center mx-auto text-2xl font-serif">
        💍
      </div>
      <div class="space-y-2">
        <h1 class="text-3xl font-serif font-bold text-stone-900">LoveStory</h1>
        <p class="text-xs uppercase tracking-widest text-amber-700 font-semibold">
          Astro High-Speed Guest Viewer
        </p>
        <p class="text-xs text-stone-500 leading-relaxed pt-2">
          Module xem thiệp cưới siêu tốc dành cho thiết bị di động. Tốc độ tải trang dưới 0.3 giây, tối ưu 100% tài nguyên CPU & GPU.
        </p>
      </div>

      <div class="pt-4 flex flex-col gap-2">
        <a
          href="/chu-re-va-co-dau"
          class="w-full py-3 px-4 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold shadow-md transition-colors"
        >
          Xem Mẫu Thiệp Mặc Định
        </a>
        <a
          href="/thuy-duong-anh-tuan"
          class="w-full py-2.5 px-4 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold transition-colors"
        >
          Xem Thiệp Thật Từ SQLite (Anh Tuấn & Thùy Dương)
        </a>
      </div>
    </div>
  </main>
</Layout>
