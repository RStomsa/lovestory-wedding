---
interface Props {
  guestName?: string;
}
const { guestName = '' } = Astro.props;
---

<section class="py-10 px-4 max-w-lg mx-auto content-auto">
  <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 sm:p-8 shadow-xl border border-stone-200/80 space-y-5 text-center">
    <div class="space-y-1">
      <span class="text-xs font-semibold tracking-widest uppercase text-amber-700">Xác Nhận Tham Dự</span>
      <h2 class="text-2xl font-serif font-bold text-stone-800">Bạn Sẽ Đến Chung Vui?</h2>
      <p class="text-xs text-stone-500">
        Xin vui lòng gửi phản hồi trước ngày cưới để gia đình chuẩn bị chu đáo nhất.
      </p>
    </div>

    <form id="rsvp-form" class="space-y-4 text-left">
      <div>
        <label for="rsvp-name" class="block text-xs font-medium text-stone-700 mb-1">Tên của bạn</label>
        <input
          type="text"
          id="rsvp-name"
          name="name"
          required
          value={guestName}
          placeholder="Ví dụ: Anh Nam, Gia đình bạn Lan"
          class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none bg-stone-50/50"
        />
      </div>

      <div>
        <label for="rsvp-phone" class="block text-xs font-medium text-stone-700 mb-1">Số điện thoại</label>
        <input
          type="tel"
          id="rsvp-phone"
          name="phone"
          placeholder="09xx xxx xxx"
          class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none bg-stone-50/50"
        />
      </div>

      <div>
        <label class="block text-xs font-medium text-stone-700 mb-2">Bạn sẽ tham dự chứ?</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-2 p-3 rounded-xl border border-stone-200 bg-stone-50 cursor-pointer hover:border-amber-400">
            <input type="radio" name="attendance" value="yes" checked class="text-amber-600 focus:ring-amber-500" />
            <span class="text-xs font-medium text-stone-800">Chắc chắn tham dự</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-xl border border-stone-200 bg-stone-50 cursor-pointer hover:border-stone-400">
            <input type="radio" name="attendance" value="no" class="text-amber-600 focus:ring-amber-500" />
            <span class="text-xs font-medium text-stone-600">Rất tiếc không thể đến</span>
          </label>
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3 px-4 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold shadow-lg active:scale-95 transition-all"
      >
        Gửi xác nhận RSVP
      </button>

      <div id="rsvp-status" class="hidden text-center text-xs font-medium text-emerald-700 bg-emerald-50 p-2.5 rounded-xl border border-emerald-200">
        ✓ Cảm ơn bạn! Gia đình đã ghi nhận phản hồi.
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('rsvp-form');
  const status = document.getElementById('rsvp-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (status) {
      status.classList.remove('hidden');
      setTimeout(() => {
        status.classList.add('hidden');
      }, 5000);
    }
  });
</script>
